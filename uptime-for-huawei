- name: Show uptime on Cisco switches
  hosts: cisco_switches
  gather_facts: no
  connection: network_cli

  tasks:
    - name: Run 'show version' to get uptime info
      ansible.netcommon.cli_command:
        command: show version
      register: output

    - name: Show uptime output
      debug:
        msg: "{{ output.stdout }}"
