- name: Show uptime on Huawei routers
  hosts: huawei_routers
  gather_facts: no
  connection: network_cli

  tasks:
    - name: Run 'display version' to get uptime info
      ansible.netcommon.cli_command:
        command: display version
      register: output

    - name: Show uptime output
      debug:
        msg: "{{ output.stdout }}"
