- name: Show uptime on Huawei routers
  hosts: huawei_routers
  gather_facts: no
  connection: network_cli

  tasks:
    - name: Run 'display version' using huawei.vrp module
      huawei.vrp.vrp_command:
        commands:
          - display version
      register: output

    - debug:
        msg: "{{ output.stdout[0] }}"
