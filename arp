- name: Cisco Playbook - Check ARP for each interface
  hosts: switch1
  gather_facts: false
  connection: network_cli

  vars:
    ansible_network_os: cisco.ios.ios
    ansible_become: yes
    ansible_become_method: enable
    ansible_become_password: "ATL@nt1$"

  tasks:
    - name: Get interface brief
      ios_command:
        commands:
          - show ip interface brief
      register: int_brief

    - name: Extract matching interface names
      set_fact:
        target_interfaces: >-
          {{
            int_brief.stdout[0].splitlines()[1:]    # skip header
            | map('regex_search', '^([^ ]+)\\s+(\\d+\\.\\d+\\.\\d+\\.\\d+)')
            | select('!=', None)
            | selectattr('0', 'search', '^GigabitEthernet0/0/2\\.(9|[1-9][0-9])$')
            | map('first')
            | list
          }}

    - name: Debug found interfaces
      debug:
        var: target_interfaces

    - name: Get ARP table for each interface
      ios_command:
        commands: "{{ target_interfaces | map('regex_replace', '^(.*)$', 'show arp interface \\1') | list }}"
      register: arp_outputs
      when: target_interfaces | length > 0

    - name: Display ARP per interface
      debug:
        var: arp_outputs.stdout_lines
      when: target_interfaces | length > 0

    - name: No interfaces found
      debug:
        msg: "No matching interfaces with IP addresses."
      when: target_interfaces | length == 0
