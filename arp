- name: Cisco Playbook - Extract all subinterfaces
  hosts: switch1
  gather_facts: false
  connection: network_cli

  vars:
    ansible_network_os: cisco.ios.ios
    ansible_become: yes
    ansible_become_method: enable
    ansible_become_password: "ATL@nt1$"

  tasks:
    - name: Get interface brief
      ios_command:
        commands:
          - show ip interface brief
      register: int_brief

    - name: Split lines and skip header
      set_fact:
        interface_lines: "{{ int_brief.stdout[0].splitlines()[1:] }}"

    - name: Extract all subinterfaces
      set_fact:
        target_interfaces: >-
          {{
            interface_lines
            | map('regex_search', '^(GigabitEthernet0/0/2\\.(?:[0-9]+))')
            | select('!=', None)
            | map('first')
            | list
          }}

    - name: Show extracted interfaces
      debug:
        var: target_interfaces
