---
- name: Cisco Playbook - Check ARP for each interface
  hosts: switch1   # match the name in your inventory
  gather_facts: false
  connection: network_cli

  tasks:
    - name: Get ARP table
      ios_command:
        commands:
          - show ip arp
      register: arp_output

    - name: Display ARP table
      debug:
        var: arp_output.stdout_lines
